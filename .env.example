# Copy this file to .env for local development.
# On Render, set these as environment variables in the service dashboard
# instead of uploading a .env file.

# Your Neon connection string (Neon dashboard -> Connection Details).
# Must include ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-string

# Optional tuning - defaults shown
JWT_EXPIRE_HOURS=168
TICK_RATE=15
STAT_FLUSH_INTERVAL=60
